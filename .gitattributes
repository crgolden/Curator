# Line-ending policy travels with the code, not with a machine.
# core.autocrlf is set only in the system-level git install on the dev boxes,
# so it does not reach a fresh clone or a CI runner. This file does.

* text=auto eol=lf

# cmd.exe is the one interpreter that genuinely requires CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Never diff, never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.bmp binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
*.dll binary
*.exe binary
*.pdb binary
*.snk binary
*.pfx binary
*.dacpac binary
*.bacpac binary
*.nupkg binary
*.snupkg binary
